# Offline development configuration. Every value here is made up.
# No real keys, tokens or passwords belong in this file or anywhere in this copy.

APP_NAME="EventsSmarter (dev)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APIV2_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local SQLite file (database/database.sqlite) - no database server needed.
DB_CONNECTION=sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail is written to storage/logs instead of being sent.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="${APP_NAME}"

# --- Third-party services: placeholders only, never contacted offline ---
AWS_ACCESS_KEY_ID=fake
AWS_SECRET_ACCESS_KEY=fake
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=fake
AWS_URL=

PUSHER_APP_ID=fake
PUSHER_APP_KEY=fake
PUSHER_APP_SECRET=fake
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_MAPS_API_KEY=fake
GOOGLE_MAPS_API_FRONT_KEY=fake

STRIPE_PUBLIC_KEY=pk_fake
STRIPE_PRIVATE_KEY=sk_fake
STRIPE_WEBHOOK_SECRET=whsec_fake

AGORA_APP_ID=fake
AGORA_APP_CERTIFICATE=fake
AGORA_BACKEND_URL=http://localhost:9999
AGORA_MEETING_PROJECT_ID=fake
AGORA_LIVESTREAM_PROJECT_ID=fake

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

TWILIO_SID=fake
TWILIO_TOKEN=fake
TWILIO_FROM=+15550000000

PAYPAL_MODE=sandbox
PAYPAL_SANDBOX_CLIENT_ID=fake
PAYPAL_SANDBOX_CLIENT_SECRET=fake
PAYPAL_SANDBOX_MERCHANT_ID=fake
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_API_URL=http://localhost:9999
PAYPAL_API_v1_URL=http://localhost:9999
PAYPAL_BN_CODE=fake
PAYPAL_MERCHANT_ID=fake
PAYPAL_WEBHOOK_ID=fake

CLOUDFLARE_ACCOUNT_ID=fake
CLOUDFLARE_TOKEN=fake

NMI_SECURITY_KEY=fake
NMI_TRANSACT_ENDPOINT=http://localhost:9999

MISTRAL_API_KEY=fake
